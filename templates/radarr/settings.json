    "fields": [
      {
        "order": 0,
        "name": "host",
        "label": "Host",
        "value": "gluetun",
        "type": "textbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 1,
        "name": "port",
        "label": "Port",
        "value": 8096,
        "type": "textbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 2,
        "name": "useSsl",
        "label": "Use SSL",
        "helpText": "Connect to Emby/Jellyfin over HTTPS instead of HTTP",
        "value": false,
        "type": "checkbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 3,
        "name": "urlBase",
        "label": "URL Base",
        "helpText": "Adds a prefix to the Emby/Jellyfin url, such as http://[host]:[port]/[urlBase]/mediabrowser",
        "type": "textbox",
        "advanced": true,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 4,
        "name": "apiKey",
        "label": "API Key",
        "value": "{{JELLYFIN_KEY_RADARR}}",
        "type": "textbox",
        "advanced": false,
        "privacy": "apiKey",
        "isFloat": false
      },
      {
        "order": 5,
        "name": "notify",
