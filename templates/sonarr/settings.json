    "name": "Emby / Jellyfin",
    "fields": [
      {
        "order": 0,
        "name": "host",
        "label": "Host",
        "value": "gluetun",
        "type": "textbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 1,
        "name": "port",
        "label": "Port",
        "value": 8096,
        "type": "textbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 2,
        "name": "useSsl",
        "label": "Use SSL",
        "helpText": "Connect to Emby/Jellyfin over HTTPS instead of HTTP",
        "value": false,
        "type": "checkbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 3,
        "name": "urlBase",
        "label": "URL Base",
        "helpText": "Adds a prefix to the Emby/Jellyfin url, such as http://[host]:[port]/[urlBase]/mediabrowser",
        "type": "textbox",
        "advanced": true,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 4,
        "name": "apiKey",
        "label": "API Key",
        "value": "{{JELLYFIN_KEY_SONARR}}",
        "type": "textbox",
        "advanced": false,
        "privacy": "apiKey",
        "isFloat": false
      },
      {
        "order": 5,
        "name": "notify",
        "label": "Send Notifications",
        "helpText": "Have Emby send notifications to configured providers. Not supported on Jellyfin.",
        "value": false,
        "type": "checkbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 6,
        "name": "updateLibrary",
        "label": "Update Library",
        "helpText": "Update Library on Import, Rename, or Delete",
        "value": true,
        "type": "checkbox",
        "advanced": false,
        "privacy": "normal",
        "isFloat": false
      },
      {
        "order": 7,
