  <ChapterAnalyzerCommercialPattern>(^|\s)(Ad(vert(isement)?)?|Commercial|Intermission)(?![\s:]+End)(\s|:|$)</ChapterAnalyzerCommercialPattern>
  <SubtitleRecapPattern>\bpreviously\s+on|^\W*(?:zuvor\s+bei|zuletzt\s+bei|was\s+bisher\s+geschah|bisher\s+bei|anteriormente|previamente|précédemment|wat\s+voorafging)|episodio?\s+precedent[ei]|^\W*前回までは|前情提要|지난\s*이야기\W*$</SubtitleRecapPattern>
  <SubtitlePreviewPattern>\b(?:here(?:'|’)?s|now)\s+the\s+preview\b|^\W*(?:\[[^\]]*\]|\([^)]*\)|[^\s:]+:)?\s*next\s+time\b</SubtitlePreviewPattern>
