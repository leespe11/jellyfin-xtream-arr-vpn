  <SkipbuttonHideDelay>8</SkipbuttonHideDelay>
  <AutoSkipIntro>false</AutoSkipIntro>
  <AutoSkipCredits>false</AutoSkipCredits>
  <SkipButtonVisibleSeconds>0</SkipButtonVisibleSeconds>
  <EnableMainMenu>true</EnableMainMenu>
